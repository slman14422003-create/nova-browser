<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nova" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/nova_bg</item>
    </style>
    <style name="Theme.Nova.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nova_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.Nova</item>
    </style>
</resources>
